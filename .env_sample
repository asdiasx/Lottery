# Optional — only when running outside Brazil (Caixa API blocks foreign IPs):
# PROXY_URL=https://your-proxy
# PROXY_TOKEN=your_token_here
DEFAULT_LOTTERY_CODE=lotomania

# Production
NODE_ENV=production
APP_URL=https://your-domain.com

# Deploy (make deploy / make rollback / make setup)
# NOTE: run "make setup" once on a new server — installs Node 20 via nvm and
# Chrome for Puppeteer (required for PDF generation via /download).
DEPLOY_TARGET=user@host:~/node_projects/adriano/Lottery
